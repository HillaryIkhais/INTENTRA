{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/types/**/*",
    "src/core/intent-parser.ts",
    "src/core/proposal-normalizer.ts",
    "src/core/intent-checker.ts",
    "src/core/transaction-planner.ts",
    "src/core/intentra-compiler.ts",
    "src/core/receipt-store.ts",
    "src/core/adversarial-tester.ts",
    "src/core/intent-parser.ts",
    "src/core/proposal-normalizer.ts",
    "src/core/intent-checker.ts",
    "src/core/transaction-planner.ts",
    "src/core/intentra-compiler.ts",
    "src/core/receipt-store.ts",
    "src/core/adversarial-tester.ts",
    "src/core/intent-parser.ts",
    "src/core/proposal-normalizer.ts",
    "src/core/intent-checker.ts",
    "src/core/transaction-planner.ts",
    "src/core/decision-engine.ts",
    "src/types/index.ts",
    "src/core/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}