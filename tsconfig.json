{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/sdk.ts", "src/publishable-sdk.ts", "src/server.ts", "src/test-compiler.ts", "src/track-b-demo.ts", "src/sdk-demo.ts", "src/server.ts", "src/sdk.ts", "src/sdk-demo.ts"]
}
