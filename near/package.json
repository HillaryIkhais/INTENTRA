    "sync:evidence": "node scripts/sync-ui-evidence.js"
  },
  "dependencies": {
    "near-api-js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
